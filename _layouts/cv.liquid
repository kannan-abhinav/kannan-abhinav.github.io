---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
    </h1>
    {% if page.cv_pdf %}
      <div class="cv-pdf-link" style="margin-top: 0.5rem;">
        <iframe
          src="{{ '/assets/pdf/example_pdf.pdf' | relative_url }}"
          width="100%"
          height="800px"
          style="border: 1px solid #ccc;"
        >
          Your browser does not support iframes. You can
          <a href="{{ '/assets/pdf/example_pdf.pdf' | relative_url }}">download the CV here</a>.
        </iframe>
      </div>
    {% endif %}
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

</div>
